# --- Ignav (https://ignav.com) ---
# Registrate gratis (sin tarjeta), 1000 requests gratis. Copia tu API key.
IGNAV_API_KEY=

# --- Ruta a monitorear ---
ORIGIN=CTG
DESTINATION=BOG
DEPARTURE_DATE=2026-10-16
RETURN_DATE=2026-10-20
ADULTS=1
# Codigo de pais de 2 letras que controla la moneda de los precios (ej. CO -> COP, US -> USD)
MARKET=CO

# --- Alertas ---
# % de caida vs. el promedio movil de ALERT_WINDOW_DAYS que dispara la alerta urgente
ALERT_DROP_PERCENT=15
# Cuantos dias de historial se promedian para calcular la caida relativa
ALERT_WINDOW_DAYS=14
# Minimo de registros en el historial antes de empezar a evaluar alertas (evita falsos positivos al inicio)
MIN_HISTORY_FOR_ALERTS=5
# Opcional: umbral absoluto adicional. Dejar vacio para desactivarlo.
ALERT_ABSOLUTE_THRESHOLD=

# --- Email (Resend: https://resend.com) ---
RESEND_API_KEY=
EMAIL_FROM=Flight Price Monitor <alerts@tudominio.com>
# Uno o varios correos separados por coma, ej: tucorreo@ejemplo.com,otra@persona.com
EMAIL_TO=tucorreo@ejemplo.com
